#!/usr/bin/env bash
# Blocks a push when any pushed commit's tree or message holds an identifier (see scripts/privacy-scan.sh).
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
msg_pattern='(^|[^0-9])[0-9]{14,20}([^0-9]|$)|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}|\(?[2-9][0-9]{2}\)?[ .-][0-9]{3}[ .-][0-9]{4}([^0-9]|$)'
# Only these exact attribution trailers skip the message scan (any case: GitHub's squash merge writes
# Co-authored-by). Any other trailer, including a co-author with a personal address, is scanned.
safe_trailers='^co-authored-by: [^<]*<noreply@anthropic\.com>$|^claude-session: https://claude\.ai/[^ ]*$'
remote=${1:-origin}
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  # A new branch scans only commits this remote doesn't have yet, not its published history.
  if [ "$remote_sha" = "$zero" ]; then range=("$local_sha" --not --remotes="$remote"); else range=("$remote_sha..$local_sha"); fi
  for sha in $(git rev-list "${range[@]}"); do
    "$root/scripts/privacy-scan.sh" "$sha" || status=1
    if git log -1 --format=%B "$sha" | grep -viE "$safe_trailers" | grep -nE "$msg_pattern"; then
      echo "pre-push: identifier in the message of $sha" >&2
      status=1
    fi
  done
done
exit $status
