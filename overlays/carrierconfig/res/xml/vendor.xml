<?xml version="1.0" encoding="utf-8"?>
<!-- Per-carrier settings the LP3 needs on a GSI. Values match what stock LightOS reports in
     `dumpsys carrier_config` for the same SIM. -->
<carrier_config_list>
    <!-- AT&T core PLMNs 310/280 (verified on a US Mobile line on AT&T's network) and 310/410. Other AT&T-network
         PLMNs (Cricket 310/150, FirstNet 313/100, ...) need a tester's SIM first. Without this the GSI leaves VoLTE
         unavailable, so IMS registers but voice stays off. -->
    <carrier_config mcc="310" mnc="280">
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="editable_enhanced_4g_lte_bool" value="false" />
        <boolean name="hide_enhanced_4g_lte_bool" value="true" />
    </carrier_config>
    <carrier_config mcc="310" mnc="410">
        <boolean name="carrier_volte_available_bool" value="true" />
        <boolean name="editable_enhanced_4g_lte_bool" value="false" />
        <boolean name="hide_enhanced_4g_lte_bool" value="true" />
    </carrier_config>
    <!-- Carrier name for MVNOs on T-Mobile's network (carrier id 1), e.g. US Mobile: their SIMs carry T-Mobile's SPN
         and T-Mobile's carrier config forces the name "T-Mobile". Show the name the network sends instead, as
         stock LightOS does: the newer display-name resolver honours the PLMN display condition; the legacy path
         only reads the SIM's own condition. A real T-Mobile SIM still shows "T-Mobile" (that's what its network
         sends). Verified on a US Mobile line on T-Mobile's network. -->
    <carrier_config cid="1">
        <boolean name="enable_carrier_display_name_resolver_bool" value="true" />
        <boolean name="carrier_name_override_bool" value="false" />
        <int name="spn_display_condition_override_int" value="1" />
    </carrier_config>
</carrier_config_list>
